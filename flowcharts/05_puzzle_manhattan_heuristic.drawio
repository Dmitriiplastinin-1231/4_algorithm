  <diagram id="puzzle-manhattan-heuristic" name="Puzzle Manhattan Heuristic">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="Ввод: состояние пазла state" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="360" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="init" value="total = 0&#xa;перебор всех (idx, value) в state" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="340" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="loop" value="Есть следующая кость?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="finish" value="Вернуть total" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="is-zero" value="value == 0?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="490" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="skip-zero" value="Пропустить пустую клетку" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="500" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="cur-pos" value="row, col = divmod(idx, PUZZLE_SIZE)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="630" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="goal-pos" value="goal_row, goal_col = GOAL_POS[value]" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="730" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="add-dist" value="total += |row-goal_row| + |col-goal_col|" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="830" width="380" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="Вывод: Manhattan distance total" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="960" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="end" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="1060" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="input" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="input" target="init" style="endArrow=classic;html=1;rounded=0;">
