        <mxCell id="e3" edge="1" parent="1" source="init" target="loop" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Нет" edge="1" parent="1" source="loop" target="finish" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Да" edge="1" parent="1" source="loop" target="is-zero" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="Да" edge="1" parent="1" source="is-zero" target="skip-zero" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="Нет" edge="1" parent="1" source="is-zero" target="cur-pos" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="cur-pos" target="goal-pos" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="goal-pos" target="add-dist" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="следующая кость" edge="1" parent="1" source="add-dist" target="loop" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="865"/>
              <mxPoint x="140" y="395"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="следующая кость" edge="1" parent="1" source="skip-zero" target="loop" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="535"/>
              <mxPoint x="930" y="395"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="finish" target="output" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="995"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="output" target="end" style="endArrow=classic;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
