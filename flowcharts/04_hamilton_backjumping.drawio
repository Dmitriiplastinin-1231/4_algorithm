        </mxCell>

        <mxCell id="input" value="Ввод: rows, cols, start, finish, blocked + режим Backjumping" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="110" width="480" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="init" value="Инициализация: free_cells, free_count,&#xa;visited={start}, path=[start],&#xa;solutions=0, nodes=0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="210" width="400" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="check-valid" value="start/finish в free_cells?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="315" y="330" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="return-zero" value="Вернуть 0 решений" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="init-stack" value="backjumps=0&#xa;stack=[{pos:start, moves:ordered_moves(start)}]" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="235" y="460" width="390" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="stack-loop" value="stack не пуст?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="590" width="210" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="Вывод: solutions, nodes, backjumps" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1390" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="end" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="1490" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="top-frame" value="frame = stack[-1], pos = frame[&quot;pos&quot;]" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="720" width="320" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="check-full" value="len(path)==free_count?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="830" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="solution-pop" value="Если pos==finish: solutions += 1&#xa;stack.pop(), visited.remove(pos), path.pop()" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="835" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="check-moves" value="frame[&quot;moves&quot;] пуст?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="970" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="dead-end-pop" value="Тупик: stack.pop(), visited.remove(pos),&#xa;path.pop(), jump_count=0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="975" width="300" height="90" as="geometry"/>
        </mxCell>

