        </mxCell>

        <mxCell id="jump-pop" value="Интеллектуальный возврат:&#xa;pop пустые вершины, visited.remove,&#xa;path.pop, jump_count += 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="1110" width="290" height="100" as="geometry"/>
        </mxCell>

