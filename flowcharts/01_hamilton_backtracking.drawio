          <mxGeometry x="315" y="320" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="return-zero" value="Вернуть 0 решений" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="call-bt" value="Вызов backtrack(start)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="bt-stop" value="Стоп-сигнал?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="550" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="bt-full" value="len(path)==free_count?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="bt-solution" value="Если pos==finish: solutions += 1\nВозврат" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="670" width="230" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="bt-loop" value="Для каждого nxt из допустимых соседей:\n1) Проверка finish на последнем шаге\n2) visited.add, path.append\n3) backtrack(nxt)\n4) path.pop, visited.remove" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="790" width="360" height="130" as="geometry"/>
        </mxCell>

