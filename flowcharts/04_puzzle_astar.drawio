<mxfile host="app.diagrams.net" modified="2026-05-16T03:16:10.796Z" agent="Mozilla/5.0" version="24.7.17" editor="agent">
  <diagram id="puzzle-astar-flowchart" name="Puzzle A* (Manhattan)">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="Ввод: начальное состояние пазла" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="360" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="check-solvable" value="is_solvable(start)?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="315" y="220" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="unsolvable" value="Нет решения (позиция неразрешима)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="230" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="init" value="Инициализация A*:&#xa;open_heap, g_score[start]=0,&#xa;came_from[start]=(None,None), nodes=0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="350" width="400" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="while-open" value="open_heap не пуст?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="no-solution" value="Вернуть: path=None, nodes" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="480" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="pop" value="Извлечь (f,g,state) из open_heap&#xa;Если g устарел: continue&#xa;nodes += 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="600" width="360" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="check-goal" value="state == GOAL_STATE?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="720" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="build-path" value="build_path(came_from, state)&#xa;Вернуть: path, nodes" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="730" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="neighbors" value="Для каждого (move, nxt) из puzzle_neighbors(state):&#xa;ng = g + 1&#xa;если ng &lt; g_score[nxt]:&#xa;обновить g_score/came_from&#xa;push (ng + manhattan(nxt), ng, nxt)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="850" width="440" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="Вывод: путь, nodes" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1010" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="end" value="Конец" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="1110" width="160" height="60" as="geometry"/>
        </mxCell>

