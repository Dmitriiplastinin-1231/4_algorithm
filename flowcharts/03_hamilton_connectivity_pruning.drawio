  <diagram id="connectivity-pruning-flowchart" name="Hamilton Connectivity Pruning">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="Ввод: rows, cols, start, finish, blocked + режим Connectivity pruning" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="205" y="110" width="450" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="init" value="Инициализация: free_cells, visited={start}, path=[start], solutions=0, nodes=0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
