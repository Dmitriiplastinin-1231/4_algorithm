          <mxGeometry x="315" y="320" width="230" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="return-zero" value="Вернуть 0 решений" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="call-bt" value="Вызов backtrack(start)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="bt-full" value="len(path)==free_count?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="bt-solution" value="Если pos==finish: solutions += 1&#xa;Возврат" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="230" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="check-connectivity" value="connectivity_ok(free_cells,&#xa;visited, rows, cols)?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="295" y="690" width="270" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="prune" value="Отсечь ветвь&#xa;Возврат" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="705" width="190" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="build-moves" value="Сформировать допустимые соседние ходы" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="840" width="290" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="loop-moves" value="Для каждого nxt из допустимых соседей:&#xa;1) проверка finish на последнем шаге&#xa;2) visited.add, path.append&#xa;3) backtrack(nxt)&#xa;4) path.pop, visited.remove" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="950" width="400" height="130" as="geometry"/>
        </mxCell>

